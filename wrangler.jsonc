{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yousef-proxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "9b292e39-d8c3-47b2-8c52-c5613ef4a2f1","database_name": "nova-proxy" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "f7cac2a143534ccbb892cae707d8f8d2" }
  ],
  "vars": {
    "PAGES_URL": "https://nova-panel.github.io"
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
